# Non-secret local development settings. The application reads process
# environment only; source this file in your shell if desired and never commit
# a resulting .env file or credentials.
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://127.0.0.1:11434
SEARCH_PROVIDER=fake
CLOUD_PROVIDERS_ENABLED=false
# Optional, only when selecting the corresponding provider. Keep blank here.
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
