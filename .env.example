# Non-secret local development settings. Copy to .env only when a later Card
# introduces a loader; do not commit the resulting .env file.
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30
SEARCH_PROVIDER=fake
CLOUD_PROVIDERS_ENABLED=false
